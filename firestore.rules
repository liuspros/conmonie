rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function grp(g) { return get(/databases/$(db)/documents/groups/$(g)).data; }
    function isAdmin(g) { return signed() && grp(g).adminId == request.auth.uid; }
    function isMember(g) { return signed() && request.auth.uid in grp(g).members; }

    match /users/{u} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == u;
      // In-app notification centre. Created by the server only; the owner reads and marks them read.
      match /notifications/{n} { allow read, update, delete: if signed() && request.auth.uid == u; }
    }
    match /invites/{c} { allow read: if signed(); allow create: if signed() && request.resource.data.adminId == request.auth.uid; }

    match /groups/{g} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && request.resource.data.adminId == request.auth.uid;
      allow update: if isAdmin(g)
        // a joiner may only add themselves
        || (signed()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'order', 'memberCount'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
        // a member may remove only themselves
        || (signed() && request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.adminId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'order', 'memberCount'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1);

      match /members/{u} {
        allow read: if isMember(g);
        allow create: if signed() && request.auth.uid == u;
        allow update: if isAdmin(g);
        allow delete: if isAdmin(g) || (signed() && request.auth.uid == u);
      }
      match /messages/{m} {
        allow read: if isMember(g);
        // Admin may post anything. Members may post text unless the admin switched the group to admins-only.
        allow create: if isMember(g) && request.resource.data.uid == request.auth.uid
          && (isAdmin(g) || (request.resource.data.type == 'text' && grp(g).get('onlyAdminsPost', false) != true));
      }
      match /contributions/{c} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
        // Once confirmed or rejected, a decision is final (no silent edits by the admin).
        allow update: if isAdmin(g) && resource.data.status == 'pending';
      }
      // Receipts (base64) are private: the sender and the admin only.
      match /receipts/{r} {
        allow read: if signed() && (resource.data.uid == request.auth.uid || isAdmin(g));
        allow create: if isMember(g) && request.resource.data.uid == request.auth.uid && request.resource.data.image.size() < 900000;
      }
      match /refs/{h} { allow read, create: if isMember(g); }
    }
  }
}
