rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function grp(g) { return get(/databases/$(db)/documents/groups/$(g)).data; }
    function isAdmin(g) { return signed() && grp(g).adminId == request.auth.uid; }
    function isMember(g) { return signed() && request.auth.uid in grp(g).members; }
    // Set only by the server once the identity check and agreement are complete.
    function verified() { return signed() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('verified', false) == true; }

    match /users/{u} {
      allow read: if signed();
      allow create: if signed() && request.auth.uid == u
        && !request.resource.data.keys().hasAny(['verified', 'verifyStatus', 'verifiedAt', 'staff', 'legalName', 'isPro', 'proExpiresAt', 'joinedGroupsCount']);
      allow update: if signed() && request.auth.uid == u
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'verifyStatus', 'verifiedAt', 'staff', 'legalName', 'isPro', 'proExpiresAt', 'joinedGroupsCount']);
      match /notifications/{n} { allow read, update, delete: if signed() && request.auth.uid == u; }
    }
    match /invites/{c} { allow read: if signed(); allow create: if signed() && request.resource.data.adminId == request.auth.uid; }

    // What the public feed shows about a group. Written by the group admin (and the server for member counts).
    match /publicGroups/{g} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.adminId == request.auth.uid && verified();
      allow update, delete: if signed() && resource.data.adminId == request.auth.uid;
    }
    // Join requests are created and decided by the server only. A person can read their own.
    match /joinRequests/{r} { allow read: if signed() && resource.data.uid == request.auth.uid; allow write: if false; }

    match /groups/{g} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && request.resource.data.adminId == request.auth.uid && verified()
        && request.resource.data.get('creatorIsProSnapshot', false) == get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('isPro', false);
      // The Pro snapshot and ping timer are written only by the server. Joining goes through /api/join, where plan limits are enforced.
      allow update: if (isAdmin(g)
          && request.resource.data.get('creatorIsProSnapshot', false) == resource.data.get('creatorIsProSnapshot', false)
          && request.resource.data.get('lastPingAt', 0) == resource.data.get('lastPingAt', 0))
        // a member may remove only themselves
        || (signed() && request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.adminId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'order', 'memberCount'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1);

      match /private/{d} { allow read, write: if isAdmin(g); }
      match /members/{u} {
        allow read: if isMember(g);
        allow create: if false;
        allow update: if isAdmin(g);
        allow delete: if isAdmin(g) || (signed() && request.auth.uid == u);
      }
      match /messages/{m} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.uid == request.auth.uid
          && (isAdmin(g) || (grp(g).get('onlyAdminsPost', false) != true
            && (request.resource.data.type == 'text' || (request.resource.data.type == 'image' && request.resource.data.image.size() < 300000))));
      }
      match /contributions/{c} {
        allow read: if isMember(g);
        allow create: if false;
        allow update: if isAdmin(g) && resource.data.status == 'pending';
      }
      match /receipts/{r} {
        allow read: if signed() && (resource.data.uid == request.auth.uid || isAdmin(g));
        allow create: if false;
      }
      // refs, reminders: server only
    }

    // ---- ConGoal: shared savings goals ----
    function gl(g) { return get(/databases/$(db)/documents/goals/$(g)).data; }
    function isOrg(g) { return signed() && gl(g).organizerId == request.auth.uid; }
    function isGMember(g) { return signed() && request.auth.uid in gl(g).members; }
    match /goals/{g} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && request.resource.data.organizerId == request.auth.uid && verified();
      allow update: if isOrg(g)
        || (signed() && request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.organizerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1);
      match /private/{d} { allow read, write: if isOrg(g); }
      match /members/{u} {
        allow read: if isGMember(g);
        allow create: if false;
        allow update: if isOrg(g);
        allow delete: if isOrg(g) || (signed() && request.auth.uid == u);
      }
      // The organizer posts updates; the server posts activity lines.
      match /messages/{m} { allow read: if isGMember(g); allow create: if isOrg(g) && request.resource.data.uid == request.auth.uid; }
      match /contributions/{c} {
        allow read: if isGMember(g);
        allow create: if false;
        allow update: if isOrg(g) && resource.data.status == 'pending';
      }
      match /receipts/{r} { allow read: if signed() && (resource.data.uid == request.auth.uid || isOrg(g)); allow create: if false; }
      // Money out is written down so every member can see where it went. Entries cannot be edited or deleted.
      match /spending/{s} { allow read: if isGMember(g); allow create: if isOrg(g); }
    }
    // verifications (ID, selfie, statement, agreement): server only, no client access
  }
}
