# Server only (never prefix with NEXT_PUBLIC). Used to read receipts.
ANTHROPIC_API_KEY=

# Push notifications (Firebase console > Project settings > Cloud Messaging > Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Server only: paste the whole service-account JSON (Project settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT=
# Server only: any long random string; also add it as a GitHub secret named CRON_SECRET
CRON_SECRET=

# Paystack (https://dashboard.paystack.com > Settings > API Keys). Server only. Use sk_test_ keys until you go live.
PAYSTACK_SECRET_KEY=
# Platform late fee in naira (default 100)
PLATFORM_LATE_FEE=100
# Optional: secret for signing receipt readings (falls back to CRON_SECRET)
SIGNING_SECRET=
